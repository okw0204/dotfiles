#!/bin/bash
set -euo pipefail

if (( $# != 1 )); then
  echo "Usage: wallpaper-set <path-to-image>" >&2
  exit 1
fi

image="$1"
current_background_link="${CURRENT_BACKGROUND_LINK:-$HOME/.local/state/omarchy/current/background}"

if [[ ! -f $image ]]; then
  echo "Wallpaper image not found: $image" >&2
  exit 1
fi

mkdir -p "$(dirname "$current_background_link")"
ln -nsf "$image" "$current_background_link"
omarchy-shell -q background refresh
